#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Install the assets a composer package ships into this application.
 *
 * A package puts an install/ directory at its root whose contents mirror the
 * application root - config/, database/migrations/, database/seeds/, htdocs/,
 * bin/, support/, var/ - and this copies them into place. See
 * src/installer/ModuleInstaller.php for the layout and the rules.
 *
 *   vendor/bin/installModule orange/acl              install a package
 *   vendor/bin/installModule orange/acl --dry-run    show what would happen
 *   vendor/bin/installModule orange/acl -o           replace what is there
 *   vendor/bin/installModule application/welcome/install    a local directory
 *
 * Deliberately standalone: no container, no console service, no application
 * bootstrap. This is registered as a composer bin, so it lands in vendor/bin
 * for anyone who installs orange/framework - including someone who installed
 * only orange/framework, where none of those things exist. It requires its own
 * classes directly for the same reason.
 *
 * Exit codes: 0 all good, 1 something was refused or failed. Conflicts count
 * as a failure so a scripted install cannot report success while leaving files
 * uncopied.
 */

use orange\framework\installer\InstallAction;
use orange\framework\installer\ModuleInstaller;
use orange\framework\exceptions\InstallerException;

$src = dirname(__DIR__) . '/src';

require_once $src . '/exceptions/OrangeException.php';
require_once $src . '/exceptions/InstallerException.php';
require_once $src . '/installer/InstallAction.php';
require_once $src . '/installer/Manifest.php';
require_once $src . '/installer/Receipt.php';
require_once $src . '/installer/ModuleInstaller.php';

exit((new InstallModuleCommand($argv))->run());

final class InstallModuleCommand
{
    protected bool $color;
    protected bool $dryRun = false;
    protected bool $overwrite = false;
    protected string $root = '';
    protected string $target = '';

    /** @param string[] $argv */
    public function __construct(protected array $argv)
    {
        $this->color = (bool) @stream_isatty(STDOUT);
    }

    public function run(): int
    {
        try {
            $this->parse();
        } catch (InstallerException $e) {
            $this->fail($e->getMessage());

            return 1;
        }

        if ($this->target === '') {
            $this->usage();

            return 1;
        }

        try {
            return $this->install();
        } catch (InstallerException $e) {
            $this->fail($e->getMessage());

            return 1;
        }
    }

    /**
     * @throws InstallerException
     */
    protected function install(): int
    {
        [$package, $source] = $this->resolve();

        $installer = new ModuleInstaller($this->root, $source, $package, $this->overwrite);

        $unmet = $installer->manifest()->unmet();

        if ($unmet !== []) {
            $this->fail('"' . $package . '" cannot be installed here:');

            foreach ($unmet as $reason) {
                $this->line('  ' . $reason);
            }

            return 1;
        }

        $this->line($this->paint('Installing ', 'bold') . $this->paint($package, 'cyan')
            . ' from ' . $this->shorten($source));

        if ($this->dryRun) {
            $this->line($this->paint('Dry run - nothing will be written.', 'yellow'));
        }

        $actions = $installer->plan();

        if ($actions === []) {
            $this->line('Nothing to install - the install directory holds no files this can place.');

            return 0;
        }

        $this->report($actions);

        if (!$this->dryRun) {
            $installer->apply($actions);
        }

        return $this->summarize($actions, $installer->manifest()->after);
    }

    /**
     * @param InstallAction[] $actions
     */
    protected function report(array $actions): void
    {
        $this->line('');

        foreach ($actions as $action) {
            [$label, $tint] = match ($action->type) {
                InstallAction::COPY => ['copy ', 'green'],
                InstallAction::MERGE => ['merge', 'green'],
                InstallAction::SKIP => ['skip ', 'grey'],
                default => ['REFUSE', 'red'],
            };

            $this->line(
                '  ' . $this->paint($label, $tint) . '  ' . $this->shorten($action->destination)
                . ($action->reason === '' ? '' : $this->paint('  (' . $action->reason . ')', 'grey'))
            );
        }

        $this->line('');
    }

    /**
     * @param InstallAction[] $actions
     * @param string[]        $after
     */
    protected function summarize(array $actions, array $after): int
    {
        $counts = [InstallAction::COPY => 0, InstallAction::MERGE => 0, InstallAction::SKIP => 0, InstallAction::CONFLICT => 0];

        foreach ($actions as $action) {
            $counts[$action->type]++;
        }

        $written = $counts[InstallAction::COPY] + $counts[InstallAction::MERGE];
        $verb = $this->dryRun ? 'would be written' : 'written';

        $this->line(
            $written . ' ' . $verb . ', ' . $counts[InstallAction::SKIP] . ' skipped, '
            . $counts[InstallAction::CONFLICT] . ' refused'
        );

        if ($counts[InstallAction::CONFLICT] > 0) {
            $this->line($this->paint('Some files were refused. Re-run with -o to replace them.', 'yellow'));

            return 1;
        }

        if ($after !== [] && !$this->dryRun && $written > 0) {
            $this->line('');
            $this->line($this->paint('Next:', 'bold'));

            foreach ($after as $note) {
                $this->line('  ' . $note);
            }
        }

        return 0;
    }

    /**
     * Work out the composer name and the install directory being installed from.
     *
     * Two forms are accepted. A composer name resolves through vendor/, which
     * is what a user actually has to hand. A path is for a module inside this
     * application, which has no vendor directory to be found in.
     *
     * @return array{0: string, 1: string}
     *
     * @throws InstallerException
     */
    protected function resolve(): array
    {
        $target = trim($this->target, '/');

        $vendored = $this->root . '/vendor/' . $target;

        if (is_dir($vendored . '/install')) {
            return [$target, $vendored . '/install'];
        }

        $local = $this->root . '/' . $target;

        if (is_dir($local . '/install')) {
            return [$target, $local . '/install'];
        }

        if (is_dir($local)) {
            // a path pointed straight at the install directory itself; name it
            // after the directory above so the receipt still says something
            return [$this->nameFor($target), $local];
        }

        throw new InstallerException(
            'Could not find an install directory for "' . $this->target . '". Looked in '
            . $this->shorten($vendored . '/install') . ' and ' . $this->shorten($local) . '.'
        );
    }

    protected function nameFor(string $path): string
    {
        $trimmed = preg_replace('#/install$#', '', $path) ?? $path;

        return str_starts_with($trimmed, 'vendor/') ? substr($trimmed, 7) : $trimmed;
    }

    /**
     * @throws InstallerException
     */
    protected function parse(): void
    {
        foreach (array_slice($this->argv, 1) as $argument) {
            if ($argument === '--dry-run' || $argument === '-n') {
                $this->dryRun = true;
            } elseif ($argument === '--overwrite' || $argument === '-o') {
                $this->overwrite = true;
            } elseif ($argument === '--no-color') {
                $this->color = false;
            } elseif ($argument === '--help' || $argument === '-h') {
                $this->target = '';

                return;
            } elseif (str_starts_with($argument, '--root=')) {
                $this->root = rtrim(substr($argument, 7), '/');
            } elseif (str_starts_with($argument, '-')) {
                throw new InstallerException('Unknown option "' . $argument . '".');
            } else {
                $this->target = $argument;
            }
        }

        if ($this->root === '') {
            $this->root = $this->findRoot();
        }

        if (!is_dir($this->root)) {
            throw new InstallerException('Application root "' . $this->root . '" is not a directory.');
        }
    }

    /**
     * The application root this script is installed under.
     *
     * Everything before the last '/vendor/' in this file's own path: that is
     * the directory composer installed into, whatever it is called and however
     * deeply nested. Falling back to walking up for a composer.json covers
     * running this from a checkout of the framework itself, where there is no
     * vendor segment at all.
     *
     * @throws InstallerException
     */
    protected function findRoot(): string
    {
        $here = str_replace('\\', '/', __DIR__);
        $marker = strrpos($here, '/vendor/');

        if ($marker !== false) {
            return substr($here, 0, $marker);
        }

        $directory = $here;

        while ($directory !== '' && $directory !== '/' && $directory !== dirname($directory)) {
            if (is_file($directory . '/composer.json')) {
                return $directory;
            }

            $directory = dirname($directory);
        }

        throw new InstallerException('Could not find the application root. Pass --root=/path/to/app.');
    }

    protected function usage(): void
    {
        $this->line('Install the files a composer package ships into this application.');
        $this->line('');
        $this->line($this->paint('  installModule <package|path> [options]', 'bold'));
        $this->line('');
        $this->line('  <package>       composer name, e.g. orange/acl');
        $this->line('  <path>          directory under the application root');
        $this->line('');
        $this->line('  -n, --dry-run   report what would happen, write nothing');
        $this->line('  -o, --overwrite replace destinations that already exist');
        $this->line('      --root=DIR  application root (default: auto-detected)');
        $this->line('      --no-color  plain output');
        $this->line('  -h, --help      this message');
    }

    protected function shorten(string $path): string
    {
        return $this->root === '' ? $path : ltrim(str_replace($this->root, '', $path), '/');
    }

    protected function fail(string $message): void
    {
        fwrite(STDERR, $this->paint($message, 'red') . PHP_EOL);
    }

    protected function line(string $message): void
    {
        fwrite(STDOUT, $message . PHP_EOL);
    }

    protected function paint(string $text, string $tint): string
    {
        if (!$this->color) {
            return $text;
        }

        $codes = ['bold' => '1', 'red' => '31', 'green' => '32', 'yellow' => '33', 'cyan' => '36', 'grey' => '90'];

        return isset($codes[$tint]) ? "\033[" . $codes[$tint] . 'm' . $text . "\033[0m" : $text;
    }
}
